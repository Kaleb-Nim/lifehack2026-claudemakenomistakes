# Server-side only -- read by app/api/realtime/session/route.ts. Never sent to the browser.
OPENAI_API_KEY=
# Optional. Defaults to gpt-realtime if unset.
OPENAI_REALTIME_MODEL=
# Optional. Defaults to marin if unset.
OPENAI_REALTIME_VOICE=
# Orders: Supabase (project ref yvcwzialpcdcrctxacpc) — SAME project and table
# as live/consumer-bot-live. The dashboard reads what the bot writes.
#
# The service_role key bypasses RLS. orders has RLS enabled with NO policies,
# so this key is the ONLY thing standing between the table and the public.
# It is read ONLY in Server Components / Route Handlers. Never add a
# NEXT_PUBLIC_ prefix — that inlines the value into the browser bundle.
SUPABASE_URL=https://yvcwzialpcdcrctxacpc.supabase.co
SUPABASE_SERVICE_KEY=

# Which merchant's orders this dashboard shows. Defaults to the canonical
# "Bizgram Asia". Set to a name that exists in the orders table, or "*" to
# show every merchant.
MERCHANT_NAME=
