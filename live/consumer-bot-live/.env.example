# Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI (agent core + tool-calling loop — wired in agent/core.py)
OPENAI_API_KEY=

# Catalog: Postgres + ParadeDB, hosted on Railway.
# Use the service's DATABASE_PUBLIC_URL (not DATABASE_URL, which is
# Railway's private-network address and only resolves from inside Railway).
CATALOG_DATABASE_URL=postgresql://postgres:<password>@<host>.proxy.rlwy.net:<port>/railway

# Orders: Supabase (project ref yvcwzialpcdcrctxacpc).
# Use the service_role key — this bot is a trusted backend, never a public
# client, so RLS is intentionally locked down to service_role only
# (see schema/orders.sql).
SUPABASE_URL=https://yvcwzialpcdcrctxacpc.supabase.co
SUPABASE_SERVICE_KEY=
