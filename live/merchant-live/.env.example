# Catalog: the SAME Postgres + ParadeDB instance the consumer agent searches.
# Publishing here is what makes an onboarded product findable in chat.
# Use the Railway service's DATABASE_PUBLIC_URL.
CATALOG_DATABASE_URL=postgresql://postgres:<password>@<host>.proxy.rlwy.net:<port>/paradedb

# Used only to embed published products. Must be the same model the scraped
# catalogue was embedded with, or the two rank on different bases.
OPENAI_API_KEY=
