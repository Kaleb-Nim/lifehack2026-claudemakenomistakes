# Server-side only -- read by app/api/realtime/session/route.ts. Never sent to the browser.
OPENAI_API_KEY=
# Optional. Defaults to gpt-realtime if unset.
OPENAI_REALTIME_MODEL=
# Optional. Defaults to marin if unset.
OPENAI_REALTIME_VOICE=
# Orders: Supabase (project ref yvcwzialpcdcrctxacpc) — SAME project and table
# as live/consumer-bot-live. The dashboard reads what the bot writes.
#
# The service_role key bypasses RLS. orders has RLS enabled with NO policies,
# so this key is the ONLY thing standing between the table and the public.
# It is read ONLY in Server Components / Route Handlers. Never add a
# NEXT_PUBLIC_ prefix — that inlines the value into the browser bundle.
SUPABASE_URL=https://yvcwzialpcdcrctxacpc.supabase.co
SUPABASE_SERVICE_KEY=

# Merchant identity. ALL OPTIONAL — this app is merchant-agnostic and names
# no shop by default.
#
# MERCHANT_NAME also scopes the dashboard: it is matched case-insensitively as
# a substring of merchant_name in the orders table, so "hock seng" matches
# "Hock Seng Electronics Pte Ltd". Leave it unset (or "*") to show every
# merchant — an unconfigured deployment must not silently filter to, or
# display, some other merchant's shop.
MERCHANT_NAME=
MERCHANT_LEGAL_NAME=
MERCHANT_OUTLET=
MERCHANT_PAYOUT_ACCOUNT=
MERCHANT_NEXT_PAYOUT=

# Catalogue: the Railway Postgres + ParadeDB instance that
# live/consumer-bot-live SEARCHES. Publishing here is what makes an onboarded
# product findable in chat — it is the whole point of this app existing
# separately from demo/merchant. Use the service's DATABASE_PUBLIC_URL.
# NOT Supabase: orders live in Supabase, the catalogue does not.
CATALOG_DATABASE_URL=
